# Flask
SECRET_KEY=your_secret_key_here
FLASK_DEBUG=True

# MySQL connection
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=flights

# Or full URL (used by SQLAlchemy)
DATABASE_URL=mysql+pymysql://root:password@localhost:3307/flights

# Admin credentials (for updatePassengerStatus)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=generate_with_werkzeug_security